<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>BetterEndfield</AssemblyName>
    <RootNamespace>BetterEndfield.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\shared\gilberta.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>2.3.1</Version>
    <InformationalVersion>2.3.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260709004" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\shared\gilberta.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource
      Include="Assets\shared\gilberta.ico"
      LogicalName="BetterEndfield.UI.Assets.shared.gilberta.ico" />
    <EmbeddedResource
      Include="Assets\model\character-presets.json"
      LogicalName="BetterEndfield.UI.Assets.model.character-presets.json" />
    <EmbeddedResource
      Include="Assets\model\character-names.json"
      LogicalName="BetterEndfield.UI.Assets.model.character-names.json" />
    <EmbeddedResource
      Include="Assets\voice\voice-catalog-index.json"
      LogicalName="BetterEndfield.UI.Assets.voice.voice-catalog-index.json" />
    <EmbeddedResource
      Include="Assets\combat\combat-dictionary.json"
      LogicalName="BetterEndfield.UI.Assets.combat.combat-dictionary.json" />
    <EmbeddedResource
      Include="..\..\manifests\shared\optiscaler.lock.json"
      LogicalName="BetterEndfield.UI.Assets.shared.optiscaler.lock.json" />
    <EmbeddedResource Include="..\..\native\modules\combat_stats\assets\avatars\*.png">
      <LogicalName>BetterEndfield.UI.Assets.combat.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target
    Name="CopyWinUIResourcesToPublish"
    AfterTargets="Publish"
    Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <WinUICompiledResource Include="$(TargetDir)*.xbf" />
      <WinUICompiledResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUICompiledResource)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
