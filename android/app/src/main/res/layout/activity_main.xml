<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_avatar"
                android:clipToOutline="true"
                android:contentDescription="@string/app_icon_description"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/gilberta" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/settings_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:text="@string/runtime_badge"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tabs"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/show_model_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/model_page"
                android:textAllCaps="false"
                android:textColor="@color/tab_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/show_voice_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/voice_page"
                android:textAllCaps="false"
                android:textColor="@color/tab_text"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/model_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/SectionEyebrow" android:text="@string/model_eyebrow" />
                <TextView style="@style/SectionTitle" android:text="@string/model_title" />
                <TextView style="@style/BodyText" android:layout_marginTop="8dp" android:text="@string/model_description" />

                <TextView
                    android:id="@+id/model_table_status"
                    style="@style/StatusPill"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/CardTitle" android:text="@string/model_basic_section" />

                <Switch
                    android:id="@+id/model_enabled"
                    style="@style/SettingSwitch"
                    android:layout_marginTop="10dp"
                    android:text="@string/model_enable" />

                <TextView style="@style/FieldLabel" android:text="@string/model_character" />
                <Spinner android:id="@+id/model_character" style="@style/InputSpinner" />
                <TextView style="@style/FieldLabel" android:text="@string/model_action" />
                <Spinner android:id="@+id/model_action" style="@style/InputSpinner" />

                <Switch
                    android:id="@+id/model_final_loop"
                    style="@style/SettingSwitch"
                    android:layout_marginTop="14dp"
                    android:text="@string/model_final_loop" />

                <Switch
                    android:id="@+id/model_force_loop"
                    style="@style/SettingSwitch"
                    android:text="@string/model_force_loop" />

                <Switch
                    android:id="@+id/model_crossfade"
                    style="@style/SettingSwitch"
                    android:text="@string/model_crossfade" />

                <TextView style="@style/FieldLabel" android:text="@string/model_loop_start" />
                <EditText
                    android:id="@+id/model_loop_start"
                    style="@style/InputEditText"
                    android:hint="0.968"
                    android:inputType="numberDecimal" />

                <TextView style="@style/FieldLabel" android:text="@string/model_loop_end" />
                <EditText
                    android:id="@+id/model_loop_end"
                    style="@style/InputEditText"
                    android:hint="2.376"
                    android:inputType="numberDecimal" />

                <TextView style="@style/FieldLabel" android:text="@string/model_crossfade_duration" />
                <EditText
                    android:id="@+id/model_crossfade_duration"
                    style="@style/InputEditText"
                    android:hint="0.20"
                    android:inputType="numberDecimal" />

                <TextView style="@style/FieldLabel" android:text="@string/model_scale" />
                <EditText
                    android:id="@+id/model_scale"
                    style="@style/InputEditText"
                    android:hint="1.0"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/CardTitle" android:text="@string/model_theme_section" />

                <Switch
                    android:id="@+id/logo_enabled"
                    style="@style/SettingSwitch"
                    android:layout_marginTop="10dp"
                    android:text="@string/logo_enable" />

                <TextView style="@style/FieldLabel" android:text="@string/logo_palette_label" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/theme_color_amber"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:contentDescription="#FFC928"
                            android:focusable="true" />

                        <View
                            android:id="@+id/theme_color_cyan"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:contentDescription="#35C8E8"
                            android:focusable="true" />

                        <View
                            android:id="@+id/theme_color_green"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:contentDescription="#41C77A"
                            android:focusable="true" />

                        <View
                            android:id="@+id/theme_color_coral"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:contentDescription="#F0645A"
                            android:focusable="true" />

                        <View
                            android:id="@+id/theme_color_magenta"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:contentDescription="#D866B7"
                            android:focusable="true" />

                        <View
                            android:id="@+id/theme_color_white"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:clickable="true"
                            android:contentDescription="#F2F2F2"
                            android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView style="@style/FieldLabel" android:text="@string/logo_color_label" />
                <EditText
                    android:id="@+id/logo_color"
                    style="@style/InputEditText"
                    android:hint="#FFC928"
                    android:inputType="textCapCharacters"
                    android:maxLength="7" />
            </LinearLayout>

            <Button
                android:id="@+id/save_model_settings"
                style="@style/PrimaryButton"
                android:layout_marginTop="14dp"
                android:text="@string/model_save" />

            <TextView
                android:id="@+id/model_selection_status"
                style="@style/SelectionSummary"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/voice_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/SectionEyebrow" android:text="@string/voice_eyebrow" />
                <TextView style="@style/SectionTitle" android:text="@string/settings_title" />
                <TextView style="@style/BodyText" android:layout_marginTop="8dp" android:text="@string/settings_description" />

                <TextView
                    android:id="@+id/voice_table_status"
                    style="@style/StatusPill"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <TextView
                style="@style/ListCaption"
                android:layout_marginTop="16dp"
                android:text="@string/voice_list_caption" />

            <LinearLayout
                android:id="@+id/voice_rule_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/restart_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notice"
            android:drawableStart="@drawable/ic_info"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:text="@string/current_setting_ready"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
