<UserControl
    x:Class="BetterEndfield.UI.Views.CustomModelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:BetterEndfield.UI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Padding="24">
            <TextBlock Text="角色外观 · BEM" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="导入 BEMv1 模型包，为每个角色选择一个包和一种外观。修改自动保存；可开启实验热切换。" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ImportButton" Content="导入 BEM / ZIP" Click="Import_Click" />
                <Button Content="其他来源 Mod 转换…" Click="Convert_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
                <Button Content="打开包目录" Click="OpenFolder_Click" />
            </StackPanel>
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="GetModelsTitle" Text="获取模型" FontSize="16" FontWeight="SemiBold" />
                    <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                        <Button x:Name="QuarkModelsButton" Content="夸克网盘" Click="ModelSource_Click" Tag="https://pan.quark.cn/s/97a9ca8f9bf2" />
                        <Button x:Name="BaiduModelsButton" Content="百度网盘" Click="ModelSource_Click" Tag="https://pan.baidu.com/s/5ekaAiiLmZKXHZ7pHH0W-Vw" />
                        <Button x:Name="KatfileModelsButton" Content="Katfile 网盘" Click="ModelSource_Click" Tag="https://katfile.biz/users/hydra405/" />
                    </controls:WrapPanel>
                </StackPanel>
            </Border>
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="LodToggle" Header="锁定高精度 LOD" Toggled="Lod_Toggled" />
                    <TextBlock x:Name="LodHint" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="HotSwitchToggle" Header="实验：模型热切换" Toggled="Experiments_Toggled" />
                    <TextBlock Text="开启后需重启游戏。之后切换包、外观或组件选项，在切换配队或重新打开详情时更新。会增加内存占用。" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="LoadingOptimizationToggle" Header="实验：模型加载优化" Toggled="Experiments_Toggled" />
                    <TextBlock Text="开启后需重启游戏。减少重复贴图构建和解压期间的内存占用。" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="SkipValidationToggle" Header="开发者：关闭模型校验" Toggled="SkipValidation_Toggled" />
                    <TextBlock Text="仅供开发测试。开启后会跳过兼容性和容量校验，可能导致游戏崩溃或模型错乱，风险自行承担。重启游戏后生效。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" />
            <ProgressRing x:Name="Busy" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
            <TextBlock x:Name="EmptyHint" Text="尚未导入模型包。已有其他格式？打开转换窗口查看支持范围与缺少的资料。" TextWrapping="Wrap" />
            <StackPanel x:Name="PackageCards" Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
