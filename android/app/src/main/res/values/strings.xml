    <string name="bem_import_activity_label">Better Endfield · 导入 BEM</string>
    <string name="ui_pc">使用 PC 界面布局</string>
    <string name="ui_pc_hint">切换键盘输入对应的界面布局，建议连接键鼠或手柄。触屏按钮可能消失；关闭后恢复此前的输入类型，不更改平台身份。重启游戏后装载此设置。</string>
    <string name="camera_fp_side_limit">第一人称侧看角度上限</string>
    <string name="camera_fp_turn_speed">第一人称转身速度</string>
    <string name="degree_per_second">°/秒</string>
    <string name="mmd_title">MMD 作品库</string>
    <string name="mmd_enable">启用 MMD 播放功能</string>
    <string name="mmd_enable_hint">播放导入作品的动作、表情、相机与音频。自动保存，重启游戏后装载；播放与状态位于游戏悬浮窗。</string>
    <string name="mmd_manage">MMD / 高级运镜 / 导入作品</string>
    <string name="mmd_description">选择包含 set.ini 及其引用文件的作品目录。文件复制到应用内部，发布成功后可供游戏读取。导入和设置自动保存，重启游戏后装载；播放结果以游戏悬浮窗状态为准。</string>
    <string name="mmd_import">选择作品目录并导入</string>
    <string name="mmd_no_works">尚未导入作品</string>
    <string name="mmd_active_work">启动时选择的作品</string>
    <string name="mmd_loop">循环播放</string>
    <string name="mmd_music">播放作品音频</string>
    <string name="mmd_seek">快进 / 快退步长（秒）</string>
    <string name="mmd_gain">音频音量（0–1）</string>
    <string name="mmd_offset">额外音频偏移（秒，-600–600，与作品偏移相加）</string>
    <string name="mmd_saved">已自动保存，重启游戏后装载。无效文本保留上次有效值。</string>
    <string name="mmd_publish">重新发布作品文件</string>
    <string name="mmd_remove">移除作品</string>
    <string name="mmd_no_selection">不预选作品</string>
    <string name="mmd_remove_title">移除这个作品？</string>
    <string name="mmd_remove_message">作品会从库中移除；正在运行的游戏在重启后刷新作品库。</string>
    <string name="mmd_body">播放身体动作</string>
    <string name="mmd_body_hint">启用作品中的角色身体动作，默认开启；需同时启用 MMD。关闭后可保留作品相机与音频播放。</string>
    <string name="mmd_face">播放表情</string>
    <string name="mmd_face_hint">使用作品中的面部表情，默认开启。播放能力以游戏悬浮窗状态为准。</string>
    <string name="mmd_motion_scale">动作位移缩放（0.05–5）</string>
    <string name="mmd_terrain">地形跟随</string>
    <string name="mmd_terrain_hint">让身体动作跟随地面高度，默认关闭；需要可用的地形接口，实际能力以游戏状态为准。</string>
    <string name="mmd_cloth_mode">布料模式</string>
    <string name="mmd_cloth_game">游戏模式</string>
    <string name="mmd_cloth_stable">稳定模式（默认）</string>
    <string name="mmd_cloth_freeze">冻结模式</string>
    <string name="mmd_cloth_hint">游戏模式保留原有布料模拟，稳定模式优先稳定播放，冻结模式固定布料；以当前角色支持的能力为准。</string>
    <string name="camera_advanced_title">高级运镜与关键帧</string>
    <string name="camera_advanced_hint">需在主设置启用自由视角，再从游戏悬浮窗启动运镜或关键帧播放。这里的参数自动保存，重启游戏后装载。</string>
    <string name="camera_motion_preset">运镜预设</string>
    <string name="camera_smoothing">镜头平滑（0–0.95）</string>
    <string name="camera_motion_speed">运镜速度（-20–20，负值反向）</string>
    <string name="camera_orbit_speed">环绕速度（-180–180°/秒）</string>
    <string name="camera_motion_duration">运镜时长（0–600 秒，0 不限时）</string>
    <string name="camera_target_height">目标高度（-5–5）</string>
    <string name="camera_keyframe_segment">关键帧段时长（0.2–60 秒）</string>
    <string name="camera_keyframe_loop">循环播放关键帧</string>
    <string name="camera_keyframe_loop_hint">关键帧路径播放到结尾后重新播放。</string>
    <string name="camera_keyframe_file_hint">关键帧文件保存在游戏内部存储的 betterendfield/camera-path.becam。保存和加载由游戏悬浮窗执行，结果以悬浮窗状态为准。</string>
</resources>
