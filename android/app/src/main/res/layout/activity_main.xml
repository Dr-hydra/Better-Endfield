<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/responsive_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_background" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:id="@+id/responsive_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="20dp" android:paddingEnd="16dp" android:paddingBottom="32dp">
        <LinearLayout android:id="@+id/app_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/app_icon_description" android:padding="3dp" android:scaleType="centerCrop" android:src="@drawable/gilberta" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:ellipsize="end" android:maxLines="2" android:fontFamily="sans-serif-medium" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="20sp" />
            </LinearLayout>
            <Button android:id="@+id/sponsor_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_sponsor_button" android:backgroundTint="@null" android:fontFamily="sans-serif-medium" android:minHeight="48dp" android:minWidth="64dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="@string/sponsor" android:textAllCaps="false" android:textColor="@color/sponsor_ink" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/page_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_tabs" android:orientation="horizontal" android:padding="4dp">
            <Button android:id="@+id/show_model_button" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_tab" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="92dp" android:padding="0dp" android:text="@string/model_page" android:textAllCaps="false" android:textColor="@color/tab_text" android:textSize="14sp" />
            <Button android:id="@+id/show_custom_model_button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_tab" android:fontFamily="sans-serif-medium" android:minHeight="48dp" android:minWidth="92dp" android:padding="0dp" android:text="@string/custom_model_page" android:textAllCaps="false" android:textColor="@color/tab_text" android:textSize="14sp" />
            <Button android:id="@+id/show_voice_button" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/bg_tab" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="92dp" android:padding="0dp" android:text="@string/voice_page" android:textAllCaps="false" android:textColor="@color/tab_text" android:textSize="14sp" />
            <Button android:id="@+id/show_enhancement_button" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/bg_tab" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="92dp" android:padding="0dp" android:text="@string/enhancement_page" android:textAllCaps="false" android:textColor="@color/tab_text" android:textSize="14sp" />
            <Button android:id="@+id/show_about_button" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="4dp" android:background="@drawable/bg_tab" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="92dp" android:padding="0dp" android:text="@string/about_page" android:textAllCaps="false" android:textColor="@color/tab_text" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/model_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/SectionTitle" android:text="@string/model_title" />
                <TextView android:id="@+id/model_table_status" style="@style/StatusPill" android:layout_marginTop="14dp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/CardTitle" android:text="@string/model_basic_section" />
                <Switch android:id="@+id/model_enabled" style="@style/SettingSwitch" android:layout_marginTop="10dp" android:text="@string/model_enable" />
                <TextView style="@style/FieldLabel" android:text="@string/model_character" />
                <Spinner android:id="@+id/model_character" style="@style/InputSpinner" />
                <TextView style="@style/FieldLabel" android:text="@string/model_action" />
                <Spinner android:id="@+id/model_action" style="@style/InputSpinner" />
                <Switch android:id="@+id/model_final_loop" style="@style/SettingSwitch" android:layout_marginTop="14dp" android:text="@string/model_final_loop" />
                <Switch android:id="@+id/model_force_loop" style="@style/SettingSwitch" android:text="@string/model_force_loop" />
                <Switch android:id="@+id/model_crossfade" style="@style/SettingSwitch" android:text="@string/model_crossfade" />
                <TextView style="@style/FieldLabel" android:text="@string/model_loop_start" />
                <EditText android:id="@+id/model_loop_start" style="@style/InputEditText" android:inputType="numberDecimal" />
                <TextView style="@style/FieldLabel" android:text="@string/model_loop_end" />
                <EditText android:id="@+id/model_loop_end" style="@style/InputEditText" android:inputType="numberDecimal" />
                <TextView style="@style/FieldLabel" android:text="@string/model_crossfade_duration" />
                <EditText android:id="@+id/model_crossfade_duration" style="@style/InputEditText" android:inputType="numberDecimal" />
                <TextView style="@style/FieldLabel" android:text="@string/model_scale" />
                <EditText android:id="@+id/model_scale" style="@style/InputEditText" android:inputType="numberDecimal" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/CardTitle" android:text="@string/model_theme_section" />
                <Switch android:id="@+id/logo_enabled" style="@style/SettingSwitch" android:layout_marginTop="10dp" android:text="@string/logo_enable" />
                <TextView style="@style/FieldLabel" android:text="@string/logo_palette_label" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" android:scrollbars="none">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <View android:id="@+id/theme_color_amber" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="10dp" android:clickable="true" android:contentDescription="#FFC928" android:focusable="true" />
                        <View android:id="@+id/theme_color_cyan" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="10dp" android:clickable="true" android:contentDescription="#35C8E8" android:focusable="true" />
                        <View android:id="@+id/theme_color_green" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="10dp" android:clickable="true" android:contentDescription="#41C77A" android:focusable="true" />
                        <View android:id="@+id/theme_color_coral" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="10dp" android:clickable="true" android:contentDescription="#F0645A" android:focusable="true" />
                        <View android:id="@+id/theme_color_magenta" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="10dp" android:clickable="true" android:contentDescription="#D866B7" android:focusable="true" />
                        <View android:id="@+id/theme_color_white" android:layout_width="42dp" android:layout_height="42dp" android:clickable="true" android:contentDescription="#F2F2F2" android:focusable="true" />
                    </LinearLayout>
                </HorizontalScrollView>
                <TextView style="@style/FieldLabel" android:text="@string/logo_wheel_label" />
                <dev.betterendfield.next.ColorWheelView android:id="@+id/logo_color_wheel" android:layout_width="240dp" android:layout_height="240dp" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" />
                <TextView style="@style/FieldLabel" android:text="@string/logo_color_label" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/logo_color" style="@style/InputEditText" android:layout_width="0dp" android:layout_weight="1" android:inputType="textCapCharacters" android:maxLength="7" />
                    <View android:id="@+id/logo_color_preview" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:contentDescription="@string/logo_color_label" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/voice_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/SectionTitle" android:text="@string/settings_title" />
                <TextView android:id="@+id/voice_table_status" style="@style/StatusPill" android:layout_marginTop="14dp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/voice_rule_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
        </LinearLayout>
        <LinearLayout android:id="@+id/custom_model_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:visibility="gone">
            <include layout="@layout/view_bem_install" />
        </LinearLayout>
        <LinearLayout android:id="@+id/enhancement_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:visibility="gone" />
        <LinearLayout android:id="@+id/about_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:visibility="gone">

            </LinearLayout>
    </LinearLayout>
</ScrollView>
