<Window
    x:Class="BetterEndfield.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="MainRoot"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="MainRoot_Loaded">
        <Grid.Resources>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FieldHintStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionStyle" TargetType="Border">
                <Setter Property="Padding" Value="0,0,0,28" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style x:Key="SettingsRowStyle" TargetType="Border">
                <Setter Property="Padding" Value="18,14" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="PathButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8" />
            </Style>
        </Grid.Resources>

        <NavigationView
            x:Name="FeatureNavigation"
            CompactModeThresholdWidth="720"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1000"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Auto"
            SelectionChanged="FeatureNavigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <Grid Margin="4,8,8,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="6">
                        <Image Source="Assets/shared/gilberta.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Better Endfield" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="11"
                            Text="终末地 Mod 控制器" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="ModelNavigationItem"
                    Content="开屏"
                    IsSelected="True"
                    Tag="model">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="VoiceNavigationItem"
                    Content="配音语言"
                    Tag="voice">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="MusicNavigationItem"
                    Content="音乐集成"
                    Tag="music">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CombatNavigationItem"
                    Content="战斗数据"
                    Tag="combat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="24,10"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="RuntimeStatusIndicator"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="RuntimeStatusTextBlock"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="正在检查运行状态…" />
                            <TextBlock
                                x:Name="LogStatusTextBlock"
                                Grid.Column="2"
                                MaxWidth="340"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                Text="尚未发现日志"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ScrollViewer
                            x:Name="ModelPageScrollViewer"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                MaxWidth="920"
                                Margin="32,28,32,44"
                                HorizontalAlignment="Stretch"
                                Spacing="28">
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="开屏" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="调整登录场景的视觉效果、角色模型与四阶段动画。"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel Spacing="18">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="界面视觉" />
                                            <TextBlock
                                                Style="{StaticResource FieldHintStyle}"
                                                Text="主题色可与原登录演员或角色替换同时使用。" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            x:Name="LogoThemeToggle"
                                            Header="自定义 Logo 与色带主题色"
                                            OffContent="使用游戏原色"
                                            OnContent="使用所选颜色" />
                                        <ContentControl
                                            HorizontalContentAlignment="Stretch"
                                            IsEnabled="{Binding IsOn, ElementName=LogoThemeToggle}">
                                            <ColorPicker
                                                x:Name="LogoThemeColorPicker"
                                                MaxWidth="360"
                                                HorizontalAlignment="Left"
                                                Color="#FFFFC928"
                                                ColorSpectrumShape="Ring"
                                                IsAlphaEnabled="False"
                                                IsColorChannelTextInputVisible="True"
                                                IsColorPreviewVisible="True"
                                                IsHexInputVisible="True"
                                                IsMoreButtonVisible="False" />
                                        </ContentControl>
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="6">
                                    <ToggleSwitch
                                        x:Name="ModelReplacementToggle"
                                        Header="启用角色替换"
                                        OffContent="保持原登录演员"
                                        OnContent="使用下方角色与动画" />
                                </StackPanel>

                                <ContentControl
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="{Binding IsOn, ElementName=ModelReplacementToggle}">
                                    <StackPanel Spacing="28">
                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="角色与动作" />
                                                    <TextBlock
                                                        Style="{StaticResource FieldHintStyle}"
                                                        Text="角色使用自己的坐姿动画链，最后动作从该角色的已索引动画中选择。" />
                                                </StackPanel>
                                                <ComboBox
                                                    x:Name="CharacterComboBox"
                                                    HorizontalAlignment="Stretch"
                                                    Header="角色模型"
                                                    DisplayMemberPath="DisplayName"
                                                    SelectionChanged="CharacterComboBox_SelectionChanged" />
                                                <ComboBox
                                                    x:Name="FinalActionComboBox"
                                                    HorizontalAlignment="Stretch"
                                                    Header="最后动作"
                                                    DisplayMemberPath="DisplayName"
                                                    SelectionChanged="FinalActionComboBox_SelectionChanged" />
                                                <StackPanel Spacing="3">
                                                    <TextBlock
                                                        x:Name="ActionDurationTextBlock"
                                                        FontWeight="SemiBold" />
                                                    <TextBlock
                                                        x:Name="ActionDescriptionTextBlock"
                                                        Style="{StaticResource FieldHintStyle}" />
                                                    <TextBlock
                                                        x:Name="PresetDetailsTextBlock"
                                                        Style="{StaticResource FieldHintStyle}" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="16" RowSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <NumberBox
                                                        x:Name="StartYawNumberBox"
                                                        Header="起始角度 (°)"
                                                        Maximum="360"
                                                        Minimum="-360"
                                                        SmallChange="1" />
                                                    <NumberBox
                                                        x:Name="TurnDurationNumberBox"
                                                        Grid.Column="1"
                                                        Header="转正时长 (秒)"
                                                        Maximum="15"
                                                        Minimum="0.1"
                                                        SmallChange="0.1" />
                                                    <NumberBox
                                                        x:Name="ScaleNumberBox"
                                                        Grid.Row="1"
                                                        Header="模型缩放"
                                                        Maximum="2"
                                                        Minimum="0.5"
                                                        SmallChange="0.05" />
                                                    <NumberBox
                                                        x:Name="LeanSampleNumberBox"
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Header="前倾采样 (秒)"
                                                        Maximum="5"
                                                        Minimum="0"
                                                        SmallChange="0.1" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="播放速度" />
                                                    <TextBlock
                                                        Style="{StaticResource FieldHintStyle}"
                                                        Text="1.0 为动画原速。各阶段独立设置，不改变镜头时间轴。" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="16" RowSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <NumberBox
                                                        x:Name="SitLoopSpeedNumberBox"
                                                        Header="坐姿循环"
                                                        Maximum="4"
                                                        Minimum="0.1"
                                                        SmallChange="0.1" />
                                                    <NumberBox
                                                        x:Name="SitSpecialSpeedNumberBox"
                                                        Grid.Column="1"
                                                        Header="坐姿小动作"
                                                        Maximum="4"
                                                        Minimum="0.1"
                                                        SmallChange="0.1" />
                                                    <NumberBox
                                                        x:Name="SitToWalkSpeedNumberBox"
                                                        Grid.Row="1"
                                                        Header="起身过渡"
                                                        Maximum="4"
                                                        Minimum="0.1"
                                                        SmallChange="0.1" />
                                                    <NumberBox
                                                        x:Name="FinalSpeedNumberBox"
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Header="最后动作"
                                                        Maximum="4"
                                                        Minimum="0.1"
                                                        SmallChange="0.1" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Spacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="连续循环" />
                                                <TextBlock
                                                    Style="{StaticResource FieldHintStyle}"
                                                    Text="可遵循资源 LoopTime、强制覆盖非循环资源，或按自定义区间交叉混合。" />
                                            </StackPanel>
                                            <ToggleSwitch
                                                x:Name="FinalLoopToggle"
                                                Header="原生循环"
                                                OffContent="播放一次并停在末帧"
                                                OnContent="使用动画 LoopTime" />
                                            <ToggleSwitch
                                                x:Name="ForceLoopToggle"
                                                Header="强制循环"
                                                OffContent="遵循动画导入设置"
                                                OnContent="覆盖非循环动画" />
                                            <ToggleSwitch
                                                x:Name="CrossfadeToggle"
                                                Header="双 Playable 交叉混合"
                                                OffContent="关闭"
                                                OnContent="按自定义区间循环"
                                                Toggled="CrossfadeToggle_Toggled" />
                                            <Grid
                                                x:Name="CrossfadeSettingsPanel"
                                                ColumnSpacing="16"
                                                RowSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <NumberBox
                                                    x:Name="LoopStartNumberBox"
                                                    Header="循环起点 (秒)"
                                                    Maximum="30"
                                                    Minimum="0"
                                                    SmallChange="0.05" />
                                                <NumberBox
                                                    x:Name="LoopEndNumberBox"
                                                    Grid.Column="1"
                                                    Header="循环终点 (秒)"
                                                    Maximum="60"
                                                    Minimum="0.05"
                                                    SmallChange="0.05" />
                                                <NumberBox
                                                    x:Name="CrossfadeDurationNumberBox"
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Header="混合时长 (秒)"
                                                    Maximum="10"
                                                    Minimum="0.01"
                                                    SmallChange="0.05" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer
                            x:Name="VoicePageScrollViewer"
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                MaxWidth="920"
                                Margin="32,28,32,44"
                                HorizontalAlignment="Stretch"
                                Spacing="28">
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="配音语言" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="为单个角色指定语音包，同时保持游戏全局语言不变。"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        Text="请先下载对应语言包。" />
                                    <ToggleSwitch
                                        x:Name="VoiceRouterToggle"
                                        Margin="0,12,0,0"
                                        Header="启用按角色配音"
                                        OffContent="全部跟随游戏"
                                        OnContent="应用下方角色规则" />
                                </StackPanel>

                                <ContentControl
                                    HorizontalContentAlignment="Stretch"
                                    IsEnabled="{Binding IsOn, ElementName=VoiceRouterToggle}">
                                    <StackPanel Spacing="28">
                                        <ToggleSwitch
                                            x:Name="NarrativeVoiceToggle"
                                            Header="替换剧情语音与口型"
                                            OffContent="剧情对话跟随游戏语言"
                                            OnContent="剧情对话应用角色规则" />

                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="18">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="设置角色语言" />
                                                    <TextBlock
                                                        Style="{StaticResource FieldHintStyle}"
                                                        Text="同一角色再次添加时会更新现有规则。" />
                                                </StackPanel>
                                                <ComboBox
                                                    x:Name="VoiceCharacterComboBox"
                                                    HorizontalAlignment="Stretch"
                                                    Header="角色"
                                                    DisplayMemberPath="DisplayName"
                                                    SelectionChanged="VoiceCharacterComboBox_SelectionChanged" />
                                                <RadioButtons
                                                    x:Name="VoiceLanguageRadioButtons"
                                                    Header="配音语言"
                                                    MaxColumns="3">
                                                    <RadioButton Content="中文" Tag="Chinese" />
                                                    <RadioButton Content="English" Tag="English" />
                                                    <RadioButton Content="日本語" Tag="Japanese" />
                                                    <RadioButton Content="한국어" Tag="Korean" />
                                                    <RadioButton Content="跟随游戏" Tag="FollowGlobal" />
                                                </RadioButtons>
                                                <Button
                                                    HorizontalAlignment="Left"
                                                    Click="AddVoiceRuleButton_Click"
                                                    Style="{StaticResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <SymbolIcon Symbol="Add" />
                                                        <TextBlock Text="添加或更新规则" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Spacing="12">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="已配置角色" />
                                            <TextBlock
                                                x:Name="VoiceRulesEmptyTextBlock"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="尚未配置角色，将全部跟随游戏全局语言。" />
                                            <ListView
                                                x:Name="VoiceRulesListView"
                                                MaxHeight="360"
                                                SelectionMode="None">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid MinHeight="56" Padding="4,6" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding DisplayName}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    FontSize="12"
                                                                    Text="{Binding Speaker}" />
                                                            </StackPanel>
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Text="{Binding LanguageDisplayName}" />
                                                            <Button
                                                                Grid.Column="2"
                                                                Click="RemoveVoiceRuleButton_Click"
                                                                Tag="{Binding Speaker}"
                                                                ToolTipService.ToolTip="删除规则">
                                                                <SymbolIcon Symbol="Delete" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </StackPanel>
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer
                            x:Name="MusicPageScrollViewer"
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                MaxWidth="920"
                                Margin="32,28,32,44"
                                HorizontalAlignment="Stretch"
                                Spacing="28">
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="OmniMix 音乐集成" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="将 OmniMix 输出的音乐送入游戏原生 Wwise 音乐总线。曲库、播放列表与后端仍由 OmniMix 管理。"
                                        TextWrapping="Wrap" />
                                    <ToggleSwitch
                                        x:Name="MusicReplacementToggle"
                                        Margin="0,12,0,0"
                                        Header="启用音乐替换"
                                        OffContent="保持游戏原生音乐"
                                        OnContent="使用 OmniMix 音乐流" />
                                </StackPanel>

                                <ContentControl
                                    HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="28">
                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="OmniMix 后端" />
                                                    <TextBlock
                                                        Style="{StaticResource FieldHintStyle}"
                                                        Text="Better Endfield 只保存后端绝对路径，不复制或修改 OmniMix 文件。" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        x:Name="OmniMixBackendPathBox"
                                                        Header="OmniMixPlayer.Backend.exe"
                                                        PlaceholderText="选择 OmniMix 后端程序" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Margin="0,24,0,0"
                                                        Click="BrowseOmniMixBackendButton_Click"
                                                        Style="{StaticResource PathButtonStyle}"
                                                        ToolTipService.ToolTip="选择并注册 OmniMix 后端">
                                                        <SymbolIcon Symbol="OpenFile" />
                                                    </Button>
                                                </Grid>
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock
                                                            x:Name="OmniMixRegistrationStatusTextBlock"
                                                            FontWeight="SemiBold"
                                                            Text="尚未注册 OmniMix 后端" />
                                                        <TextBlock
                                                            x:Name="OmniMixClientIdTextBlock"
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="客户端标识将在注册时生成。" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Click="UnregisterOmniMixButton_Click"
                                                        Content="解除注册" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="替换范围" />
                                                    <TextBlock
                                                        Style="{StaticResource FieldHintStyle}"
                                                        Text="关闭的场景继续使用游戏原生音乐。" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="ReplaceLoginMusicToggle"
                                                    Header="登录场景"
                                                    OffContent="原生音乐"
                                                    OnContent="OmniMix" />
                                                <ToggleSwitch
                                                    x:Name="ReplaceMetaMusicToggle"
                                                    Header="主界面与基地"
                                                    OffContent="原生音乐"
                                                    OnContent="OmniMix" />
                                                <ToggleSwitch
                                                    x:Name="ReplaceGameplayMusicToggle"
                                                    Header="游戏内场景"
                                                    OffContent="原生音乐"
                                                    OnContent="OmniMix" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="缓冲与回退" />
                                                    <TextBlock
                                                        Style="{StaticResource FieldHintStyle}"
                                                        Text="只有 PCM 达到预缓冲且 Wwise 回调正常后，原游戏音乐才会暂停。" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <NumberBox
                                                        x:Name="MusicTargetLatencyNumberBox"
                                                        Header="OmniMix 目标延迟 (秒)"
                                                        Maximum="2"
                                                        Minimum="0.1"
                                                        SmallChange="0.05" />
                                                    <NumberBox
                                                        x:Name="MusicPrebufferNumberBox"
                                                        Grid.Column="1"
                                                        Header="本地预缓冲 (毫秒)"
                                                        Maximum="1000"
                                                        Minimum="50"
                                                        SmallChange="25" />
                                                </Grid>
                                                <ToggleSwitch
                                                    x:Name="FallbackToNativeMusicToggle"
