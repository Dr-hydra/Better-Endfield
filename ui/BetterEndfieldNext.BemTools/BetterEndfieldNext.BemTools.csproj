<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>BetterEndfieldNext.BemTools</AssemblyName>
    <RootNamespace>BetterEndfieldNext.BemTools</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\BetterEndfieldNext.UI\Assets\shared\gilberta.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260709004" />
    <Compile Include="..\BetterEndfieldNext.UI\Controls\PageContentPanel.cs" Link="Shared\PageContentPanel.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Views\BemConverterWindow.cs" Link="Shared\BemConverterWindow.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Views\BemLocalizedUI.cs" Link="Shared\BemLocalizedUI.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Services\BemToolService.cs" Link="Shared\BemToolService.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Services\BemExportProject.cs" Link="Shared\BemExportProject.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Services\BemReportPresentation.cs" Link="Shared\BemReportPresentation.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Services\BemText.cs" Link="Shared\BemText.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Services\LocalizationService.cs" Link="Shared\LocalizationService.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Services\WindowPlacementService.cs" Link="Shared\WindowPlacementService.cs" />
    <Compile Include="..\BetterEndfieldNext.UI\Services\WindowPlacementGeometry.cs" Link="Shared\WindowPlacementGeometry.cs" />
    <EmbeddedResource Include="..\BetterEndfieldNext.UI\Assets\locales\*.json"
      LogicalName="BetterEndfieldNext.UI.Assets.locales.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
