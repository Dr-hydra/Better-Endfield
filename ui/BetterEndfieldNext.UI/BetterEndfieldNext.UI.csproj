<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>BetterEndfieldNext</AssemblyName>
    <RootNamespace>BetterEndfieldNext.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\shared\gilberta.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <BEObfuscate Condition="'$(BEObfuscate)' == '' and '$(Configuration)' == 'Release'">true</BEObfuscate>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260709004" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\resources\bem-preview\*" Exclude="..\..\resources\bem-preview\*.zip">
      <LogicalName>BetterEndfieldNext.BemPreview.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Transform only the application assembly; WinUI and framework binaries
       retain their metadata. The clean output assembly stays untouched. -->
  <Target Name="ObfuscateNextApplication" AfterTargets="PrepareForBundle"
          Condition="'$(BEObfuscate)' == 'true' and '$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <NextObfuscationDirectory>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)next-obfuscated'))</NextObfuscationDirectory>
    </PropertyGroup>
    <ItemGroup>
      <NextOriginalAssembly Include="@(FilesToBundle)" Condition="'%(FilesToBundle.Filename)%(FilesToBundle.Extension)' == '$(AssemblyName).dll'" />
    </ItemGroup>
    <Error Condition="'@(NextOriginalAssembly)' == ''" Text="Next application assembly is missing from the bundle inputs." />
    <Exec Command="pwsh -NoProfile -File &quot;$(BEWorkspaceRoot)scripts\ObfuscateNext.ps1&quot; -AssemblyPath &quot;@(NextOriginalAssembly->'%(FullPath)')&quot; -OutputDirectory &quot;$(NextObfuscationDirectory)&quot; -DependencyDirectory &quot;$(TargetDir.TrimEnd('\'))&quot;" />
    <ItemGroup>
      <FilesToBundle Remove="@(NextOriginalAssembly)" />
      <FilesToBundle Include="$(NextObfuscationDirectory)\$(AssemblyName).dll">
        <RelativePath>$(AssemblyName).dll</RelativePath>
      </FilesToBundle>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Assets\shared\gilberta.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource
      Include="Assets\sponsor\wechat-appreciation.png"
      LogicalName="BetterEndfieldNext.UI.Assets.sponsor.wechat-appreciation.png" />
    <EmbeddedResource
      Include="Assets\shared\gilberta.ico"
      LogicalName="BetterEndfieldNext.UI.Assets.shared.gilberta.ico" />





    <EmbeddedResource
      Include="..\..\manifests\shared\optiscaler.lock.json"
      LogicalName="BetterEndfieldNext.UI.Assets.shared.optiscaler.lock.json" />
    <EmbeddedResource
      Include="Assets\locales\*.json"
      LogicalName="BetterEndfieldNext.UI.Assets.locales.%(Filename)%(Extension)" />


  </ItemGroup>

  <Target
    Name="CopyWinUIResourcesToPublish"
    AfterTargets="Publish"
    Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <WinUICompiledResource Include="$(TargetDir)*.xbf" />
      <WinUICompiledResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUICompiledResource)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>
  <PropertyGroup>
    <BECoreConfigArg Condition="'$(BEWorkspaceConfig)' != ''">--workspace-config &quot;$(BEWorkspaceConfig)&quot;</BECoreConfigArg>
  </PropertyGroup>
  <Target Name="StageExternalCoreForBuild" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="python &quot;$(BEWorkspaceRoot)scripts\BuildResourcePacks.py&quot; $(BECoreConfigArg) --character-presets &quot;$(BECharacterPresetsPath)&quot; --voice-index &quot;$(BEVoiceCatalogIndexPath)&quot; --combat-dictionary &quot;$(BECombatDictionaryPath)&quot; --platform windows --type core --output &quot;$(TargetDir)resources&quot;" />
  </Target>
  <Target Name="StageExternalCoreForPublish" AfterTargets="Publish">
    <Exec Command="python &quot;$(BEWorkspaceRoot)scripts\BuildResourcePacks.py&quot; $(BECoreConfigArg) --character-presets &quot;$(BECharacterPresetsPath)&quot; --voice-index &quot;$(BEVoiceCatalogIndexPath)&quot; --combat-dictionary &quot;$(BECombatDictionaryPath)&quot; --platform windows --type core --output &quot;$(PublishDir)resources&quot;" />
  </Target>
</Project>
