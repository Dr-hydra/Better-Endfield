<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".ModuleApplication"
        android:description="@string/xposed_description"
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@drawable/gilberta"
        android:label="@string/app_name"
        android:roundIcon="@drawable/gilberta"
        android:supportsRtl="true">
        <activity android:name=".BemInstallActivity" android:exported="false" android:theme="@style/AppTheme" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
