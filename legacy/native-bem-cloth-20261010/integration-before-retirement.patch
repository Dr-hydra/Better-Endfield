+bool AndroidReadMeshGeometry(void* mesh,BetterEndfieldNext::CustomModel::BemComponent& component) {
+    if(!mesh||!AndroidMeshBuilderReady())return false;
+    try {
+        Calls calls;MeshDataScope data{calls};data.Init(mesh);void* args[]{&data.data};
+        const int vertices=calls.Value<int32_t>(api.vertex_count,nullptr,args);
+        const int streams=calls.Value<int32_t>(api.buffer_count,nullptr,args);
+        const int subs=calls.Value<int32_t>(api.sub_count,nullptr,args);
+        if(vertices<=0||vertices>1048576||streams!=3||subs<=0||subs>256)return false;
+        auto format=runtime->ResolveMethodExact(kAssembly,"UnityEngine","Mesh","get_indexFormat","","UnityEngine.Rendering.IndexFormat",0);
+        const int index_format=calls.Value<int32_t>(format,mesh);if(index_format<0||index_format>1)return false;
+        component={};component.info.vertex_count=vertices;component.info.index_element_size=index_format?4:2;
+        uint32_t strides[3]{};
+        for(int stream=-1;stream<streams;++stream) {
+            void* read_args[]{&data.data,&stream};
+            const uint64_t size=calls.Value<uint64_t>(stream<0?api.index_size:api.vertex_size,nullptr,read_args);
+            const uintptr_t pointer=calls.Value<uintptr_t>(stream<0?api.index_ptr:api.vertex_ptr,nullptr,read_args);
+            if(!pointer||!size||size>64u*1024u*1024u||pointer>UINTPTR_MAX-size)return false;
+            auto& bytes=stream<0?component.indices:component.streams[stream];
+            bytes.assign(reinterpret_cast<const uint8_t*>(pointer),reinterpret_cast<const uint8_t*>(pointer)+size);
+            if(stream>=0){if(size%vertices)return false;strides[stream]=size/vertices;}
+        }
+        component.info.stride0=strides[0];component.info.stride1=strides[1];component.info.stride2=strides[2];
+        if(component.indices.size()%component.info.index_element_size)return false;
+        component.info.index_count=component.indices.size()/component.info.index_element_size;
+        int attributes=calls.Value<int32_t>(api.attribute_count,mesh);if(attributes<=0||attributes>16)return false;
+        for(int i=0;i<attributes;++i){void* a[]{&i};component.attributes.push_back(calls.Value<std::array<int32_t,4>>(api.attribute,mesh,a));}
+        for(int i=0;i<subs;++i) {
+            SubMesh sub{};void* a[]{&data.data,&i,&sub};calls.Call(api.sub,nullptr,a);
+            if(sub.topology!=0||sub.base!=0||sub.start<0||sub.count<0||uint64_t(sub.start)+sub.count>component.info.index_count)return false;
+            BetterEndfieldNext::CustomModel::BemComponent::Draw draw{};draw.start=sub.start;draw.count=sub.count;
+            component.draws.push_back(draw);
+        }
+        return true;
+    }catch(const std::exception& e){LogError(kLog,e.what());return false;}
+}
+bool AndroidUpdateMeshPackedGeometry(void* mesh,const std::vector<float>& positions,const std::vector<uint32_t>& frames) {
+    if(!mesh||frames.empty()||positions.size()!=frames.size()*3||frames.size()>1048576)return false;
+    try {
+        Calls calls;
+        auto setter=runtime->ResolveMethodExact(kAssembly,"UnityEngine","Mesh","SetNativeArrayForChannelImpl",
+            "UnityEngine.Rendering.VertexAttribute|UnityEngine.Rendering.VertexAttributeFormat|System.Int32|System.IntPtr|System.Int32|System.Int32|System.Int32|UnityEngine.Rendering.MeshUpdateFlags","System.Void",8);
+        if(!setter.info)return false;
+        int32_t format=0,start=0,count=frames.size(),flags=0;
+        // This Android player's normal-channel setter consumes float3 even
+        // when dimension=1 is supplied. Never pass packed TBN words to it.
+        // Position writes use the observed float3 contract; packed frames stay
+        // in their original stream until a separate normal writer is verified.
+        for(int32_t channel:{0}) {
+            int32_t dimension=3;
+            uintptr_t pointer=reinterpret_cast<uintptr_t>(positions.data());
+            void* args[]{&channel,&format,&dimension,&pointer,&count,&start,&count,&flags};calls.Call(setter,mesh,args);
+        }
+        return true;
+    }catch(const std::exception& e){LogError(kLog,e.what());return false;}
+}
