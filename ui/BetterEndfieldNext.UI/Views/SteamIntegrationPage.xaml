<UserControl
    x:Class="BetterEndfieldNext.UI.Views.SteamIntegrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterEndfieldNext.UI.Controls">
    <Border Padding="22" CornerRadius="12" BorderThickness="1"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel x:Name="SteamBody" Spacing="12">
            <TextBlock x:Name="TitleText" Text="Steam 国服启动（预览）" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="IntroText" Text="在 Steam 库中直接启动国服，使用 BE 的 XInput 自启动加载模块。" TextWrapping="Wrap" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="SteamPathBox" Header="Steam 程序" PlaceholderText="steam.exe" TextChanged="PreferencesChanged" />
                <Button x:Name="DetectButton" Grid.Column="1" Margin="0,24,0,0" Content="自动检测" Click="Detect_Click" />
            </Grid>
            <ComboBox x:Name="LibraryBox" Header="Steam 游戏库" HorizontalAlignment="Stretch" SelectionChanged="PreferencesChanged" />
            <CheckBox x:Name="AutoUpdateBox" HorizontalAlignment="Stretch" Content="BE 自动查询最新元数据，并在 Steam 退出后更新 ACF" Checked="PreferencesChanged" Unchecked="PreferencesChanged" />
            <CheckBox x:Name="AdministratorBox" HorizontalAlignment="Stretch" Content="以管理员身份启动 Steam（覆盖层兼容，可选）" Checked="PreferencesChanged" Unchecked="PreferencesChanged" />
            <TextBlock x:Name="AdministratorHint" Text="默认关闭。当前实测普通权限仍可记录时长和展示状态；游戏提权时，管理员启动有助于覆盖层和截图。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ExitHint" Text="应用、更新或移除 ACF 前，请在 Steam 菜单选择“退出”，并确认托盘后台也已结束。" TextWrapping="Wrap" />
            <TextBlock x:Name="MetadataText" Text="等待获取完整元数据。" TextWrapping="Wrap" />
            <TextBlock x:Name="ClientText" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
            <StackPanel x:Name="ActionPanel" Spacing="8">
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button x:Name="FetchButton" Content="获取元数据" Click="Fetch_Click" />
                    <Button x:Name="ImportButton" Content="导入元数据…" Click="Import_Click" />
                    <Button x:Name="PreviewButton" Content="预览 ACF" Click="Preview_Click" />
                </controls:WrapPanel>
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button x:Name="ApplyButton" Content="应用 / 更新 ACF" Click="Apply_Click" />
                    <Button x:Name="RestoreButton" Content="移除 BE 的 ACF" Click="Restore_Click" />
                    <Button x:Name="CopyButton" Content="复制启动命令" Click="Copy_Click" />
                </controls:WrapPanel>
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button x:Name="StartButton" Content="从 Steam 启动国服" Click="Start_Click" />
                    <Button x:Name="SyncAdminButton" Content="同步 Windows 管理员设置" Click="SyncAdmin_Click" />
                    <Button x:Name="RestoreAdminButton" Content="恢复管理员设置" Click="RestoreAdmin_Click" />
                </controls:WrapPanel>
            </StackPanel>
            <TextBlock x:Name="CopyHint" Text="首次配置后，将复制的命令粘贴到 Steam 游戏属性的“启动选项”。国服仍由官方启动器更新。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </Border>
</UserControl>
