    <string name="voice_list_caption">全角色语言规则</string>
    <string name="settings_description">为每名角色独立选择中文、英文、日文、韩文或跟随游戏。角色与语气词对照表直接复用桌面端内置旧表；所需 resident catalog 会在下次启动游戏时从手机本机语言包单独生成。</string>
    <string name="voice_table_ready">桌面端旧表已加载：%1$d 名角色，%2$d 个角色/语言目录。</string>
