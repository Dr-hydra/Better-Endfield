                                    <Button
                                        HorizontalAlignment="Left"
                                        Click="ViewDisclaimerButton_Click"
                                        Content="查看完整说明" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border
                        x:Name="ActionBar"
                        Grid.Row="2"
                        Padding="20,12"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PageSelectionHintTextBlock"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="保存后在下一次注入时生效。"
                                TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Click="ResetButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <SymbolIcon Symbol="Undo" />
                                    <TextBlock Text="恢复默认" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Click="SaveButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="保存" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="3"
                                Click="LaunchButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        x:Name="LaunchProgressRing"
                                        Width="16"
                                        Height="16"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="保存并启动" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <InfoBar
                        x:Name="StatusInfoBar"
                        Grid.Row="3"
                        Margin="16,8,16,12"
                        IsClosable="True"
                        IsOpen="False" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
