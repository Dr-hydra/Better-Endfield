; EFMI ALPHA-13 INI

{%- macro note(text, indent=0) %}{{ " " * indent }}{% if comment_code %}; {{ text }}{% else %};DEL{% endif %}{% endmacro %}

{%- if cfg.use_ini_toggles %}

; ------------------------------------------------------------------------------
; - KEY BINDINGS
; ------------------------------------------------------------------------------

{{note("Hotkeys generated from Ini Toggles")}}
{%- for var in cfg.ini_toggles.vars -%}
{%- if var.hotkeys %}

[KeySwap{{ formatter.format_name_camel_case(var.name) }}]
condition = $object_detected == 1
{%- for hotkeys in formatter.format_hotkeys(var.hotkeys) %}
key = {{ hotkeys }}
{%- endfor %}
type = cycle
{{ formatter.format_ini_swapvar(var.name) }} = {{ var.states | map(attribute='name') | join(', ') }}
{%- endif -%}
{%- endfor %}
{%- endif %}


; ------------------------------------------------------------------------------
; - MOD INFO
; ------------------------------------------------------------------------------

{{note("Name of mod")}}
[ResourceModName]

{%- if mod_info.mod_name.strip() != '' %}
type = Buffer
data = "{{ mod_info.mod_name }}"
{%- else %}
; type = Buffer
; data = "Unknown Mod Name"
{%- endif %}

{{note("Name of mod author")}}
[ResourceModAuthor]
{%- if mod_info.mod_author.strip() != '' %}
type = Buffer
data = "{{ mod_info.mod_author }}"
{%- else %}
; type = Buffer
; data = "Unknown Mod Author"
{%- endif %}

{{note("Mod description")}}
[ResourceModDesc]
{%- if mod_info.mod_desc.strip() != '' %}
type = Buffer
data = "{{ mod_info.mod_desc }}"
{%- else %}
; type = Buffer
; data = "Empty Mod Description"
{%- endif %}

{{note("Link to mod repository")}}
[ResourceModLink]
{%- if mod_info.mod_link.strip() != '' %}
type = Buffer
data = "{{ mod_info.mod_link }}"
{%- else %}
; type = Buffer
; data = "Empty Mod Link"
{%- endif %}

{{note("Texture file with 512x512 .dds (BC7 SRGB) mod logo")}}
[ResourceModLogo]
{%- if mod_info.mod_logo.is_file() %}
filename = Textures/Logo.dds
{%- else %}
; filename = Textures/Logo.dds
{%- endif %}


; ------------------------------------------------------------------------------
; - MOD STATE
; ------------------------------------------------------------------------------

{{note("Global variables used by entire mod")}}
[Constants]
{{note("Allows EFMI to safely disable incompatible mod and notify user about it")}}
global $required_efmi_version = {{ '%0.2f'| format(mod_info.required_efmi_version.as_float()) }}
{{note("Number of indices in original model")}}
global $object_guid = {{ extracted_object.index_count }}
{{note("Number of vertices in custom model")}}
global $mesh_vertex_count = {{ merged_object.vertex_count }}
global $component_count = {{ extracted_object.components | length }}
global $max_instance_count = {{ cfg.max_instance_count }}
global $bones_count = {{ extracted_object.components | selectattr('cpu_posed', 'equalto', false) | sum(attribute='vg_count') }}
{{note("ID assigned to our mod by EFMI")}}
global $mod_id = -1000
{{note("Controls whether our mod is enabled, prevents any overrides from happening if $mod_enabled == 0")}}
{{note("Prevents user from being crash-locked in case of incompatible EFMI version")}}
global $mod_enabled = 0
{{note("Indicates if our object was detected in previous frame")}}
global $object_detected = 0
{{note("Indicates if our object has LoDs applied")}}
global $lod_level = 0
{%- if cfg.use_ini_toggles %}
; Swap vars aka state values for toggles (marked as `persist` to keep state saved in `d3dx_user.ini`)
{%- for var in cfg.ini_toggles.vars %}
global persist {{ formatter.format_ini_swapvar(var.name) }} = {{ var.default_state or 0 }}
{%- endfor %}
; Per-object state vars (dynamically controlled by CommandListProcessToggles)
{%- for component_id, component_metadata in enumerate(extracted_object.components) %}
{%- for obj in merged_object.components[component_id].objects %}
global {{ formatter.format_ini_drawvar(obj.name) }} = 1
{%- endfor %}
{%- endfor %}
{%- endif %}


{{note("List of commands executed for every frame")}}
[Present]
if $object_detected
    if $mod_enabled
        post $object_detected = 0
        {%- if cfg.use_ini_toggles %}
        run = CommandListProcessToggles
        {%- endif %}
    else
        {{note("Check if our mod is compatible with installed EFMI version (runs only once)")}}
        if $mod_id == -1000
            {{note("Pass required EFMI version along with mod metadata to EFMI")}}
            run = CommandListRegisterMod
        endif
    endif
endif


{{note("Contacts EFMI to check whether installed version is compatible with our mod")}}
[CommandListRegisterMod]
{{note("Pass mod info variables to EFMI")}}
$\EFMIv1\required_version = $required_efmi_version
$\EFMIv1\object_guid = $object_guid
{{note("Pass mod info resources to EFMI")}}
Resource\EFMIv1\ModName = ref ResourceModName
Resource\EFMIv1\ModAuthor = ref ResourceModAuthor
Resource\EFMIv1\ModDesc = ref ResourceModDesc
Resource\EFMIv1\ModLink = ref ResourceModLink
Resource\EFMIv1\ModLogo = ref ResourceModLogo
{{note("Register mod in EFMI")}}
run = CommandList\EFMIv1\RegisterMod
{{note("Read mod_id assigned to our mod by EFMI, incompatible mod will get `$mod_id == -1` assigned")}}
$mod_id = $\EFMIv1\mod_id
{{note("Enable our mod if EFMI assigned valid $mod_id to it")}}
if $mod_id >= 0
    $mod_enabled = 1
endif

{%- if cfg.use_ini_toggles %}

{{note("Handles toggles logic")}}
[CommandListProcessToggles]
; Set display of each object according to toggles logic
{%- for object_name, conditions in cfg.ini_toggles.compile_conditions().items() %}
{{ formatter.format_ini_drawvar(object_name) }} = {{ conditions }}
{%- endfor %}
{{note("<< Here's a nice place to put your custom logic that controls objects visibility >>")}}
{%- endif %}


; ------------------------------------------------------------------------------
; - CUSTOM MESH DRAW CALLS
; ------------------------------------------------------------------------------

{%- for component_id, component_metadata in enumerate(extracted_object.components) %}

{%- set component_data = merged_object.components[component_id] %}
{%- set has_objects = component_data.objects | length > 0 %}
{%- set has_shapekeys = component_data.shapekeys.vertex_count > 0 %}
{%- set indent = 4 if cfg.use_ini_toggles else 0 %}
{%- set draw_spacing = " " * indent %}

{{note("Do custom draw calls for Component %d" | format(loop.index0))}}
[CommandList_Draw_Component{{ component_id }}]

{%- if has_objects or component_metadata.cpu_posed %}
{{note("Trigger TextureOverride sections for PS slots from 0 to 22 with matching `hash` values")}}
{{note("If hash of resource in slot matches TextureOverride hash, TextureOverride puts defined custom texture Resource in `this` slot")}}
run = CommandList\EFMIv1\OverrideTextures
{%- else %}
; No matching objects found for this component in Blender.
; Uncomment to trigger textures replacement (original textures are not modified when commented):
;run = CommandList\EFMIv1\OverrideTextures
{%- endif %}

{%- if not has_objects or component_metadata.cpu_posed %}

{%- if cfg.use_spatial_identification %}
{{note("Spatial identification allows to use different resources for each instance")}}
{{note("Draw single instance with original mesh (called multiple times in per-instance loop)")}}
{%- if component_metadata.cpu_posed and has_objects %}
; Component is posed on CPU, vertex buffers modding is not supported.
; Draw this component using original in-game meshes:
drawindexed = INDEX_COUNT, FIRST_INDEX, 0
{%- else %}
; Uncomment to draw original in-game mesh for this component (original component is hidden when commented):
;drawindexed = INDEX_COUNT, FIRST_INDEX, 0
{%- endif %}
{%- else %}
{{note("Draw all instances with original mesh at once")}}
{%- if component_metadata.cpu_posed and has_objects %}
; Component is posed on CPU, vertex buffers modding is not supported.
; Draw this component using original in-game meshes:
drawindexedinstanced = INDEX_COUNT, INSTANCE_COUNT, FIRST_INDEX, 0, FIRST_INSTANCE
{%- else %}
; Uncomment to draw original in-game mesh for this component (original component is hidden when commented):
;drawindexedinstanced = INDEX_COUNT, INSTANCE_COUNT, FIRST_INDEX, 0, FIRST_INSTANCE
{%- endif %}
{%- endif %}

{%- else %}
{{note("Do by-slot resource overrides")}}
ib = ref Resource_Component{{ component_id }}_IB
{%- if has_shapekeys %}
{{note("Process pending component shapekeyes update (apply morphs to vertex positions data)")}}
run = CommandList_ShapeKeys_Apply
{%- endif %}
{{note("Conditional vertex buffers swap (with multiple LoD levels support)")}}
if $lod_level == 0
    {%- if not has_shapekeys %}
    {{note("Contains vertex positions and TBN data")}}
    vb0 = ref Resource_Component{{ component_id }}_VB0
    {{note("Some shaders (e.g. wetness) are being supplied with differently mapped VB0 copy")}}
    vb3 = ref Resource_Component{{ component_id }}_VB0
    {%- else %}
    {{note("Use VB0 for current UID from shapekeyed positions pool")}}
    vb0 = ref Pool_ShapeKeyedPositionsRW[$shapekeyed_position_uid]
    vb3 = ref Pool_ShapeKeyedPositionsRW[$shapekeyed_position_uid]
    {%- endif %}
    {%- if 'Component'~component_id~'_VB1' in buffers.keys() %}
    {{note("Usually contains UV maps and vertex colors")}}
    vb1 = ref Resource_Component{{ component_id }}_VB1
    {%- endif %}
    {%- if 'Component'~component_id~'_VB2' in buffers.keys() %}
    {{note("Use VB2 with weights for full model")}}
    vb2 = ref Resource_Component{{ component_id }}_VB2
    {%- endif %}
{%- for lod_id, lod in enumerate(component_metadata.lods) %}
elif $lod_level == {{ lod_id + 1 }}
    {%- if not has_shapekeys %}
    {%- if "VB0" in lod.vb_formats %}
    {{note("Use VB0 with LoD mesh layout")}}
    vb0 = ref Resource_Component{{ component_id }}_VB0_LOD{{ lod_id + 1 }}
    vb3 = ref Resource_Component{{ component_id }}_VB0_LOD{{ lod_id + 1 }}
    {%- else %}
    {{note("Use VB0 with full mesh layout")}}
    vb0 = ref Resource_Component{{ component_id }}_VB0
    vb3 = ref Resource_Component{{ component_id }}_VB0
    {%- endif %}
    {%- else %}
    {{note("Use VB0 for current UID from shapekeyed positions pool")}}
    vb0 = ref Pool_ShapeKeyedPositionsRW[$shapekeyed_position_uid]
    vb3 = ref Pool_ShapeKeyedPositionsRW[$shapekeyed_position_uid]
    {%- endif %}
    {%- if "VB1" in lod.vb_formats %}
    {{note("Use VB1 with LoD mesh layout")}}
    vb1 = ref Resource_Component{{ component_id }}_VB1_LOD{{ lod_id + 1 }}
    {%- elif 'Component'~component_id~'_VB1' in buffers.keys() %}
    {{note("Use VB1 with full mesh layout")}}
    vb1 = ref Resource_Component{{ component_id }}_VB1
    {%- endif %}
    {%- if "VB2" in lod.vb_formats or (lod.vg_map and merged_object.skeleton_type.value != "Merged") %}
    {{note("Use VB2 with LoD mesh layout and/or remapped weights (if LoD mesh uses simplified skeleton)")}}
    vb2 = ref Resource_Component{{ component_id }}_VB2_LOD{{ lod_id + 1 }}
    {%- elif 'Component'~component_id~'_VB2' in buffers.keys() %}
    {{note("Use VB2 with full mesh layout and/or full model weights (if LoD mesh uses full skeleton)")}}
    vb2 = ref Resource_Component{{ component_id }}_VB2
    {%- endif %}
{%- endfor %}
endif

{%- for obj in component_data.objects %}
{%- if cfg.use_ini_toggles %}
if {{ formatter.format_ini_drawvar(obj.name) }}
{%- endif %}
{{ draw_spacing }}; Draw object "{{ obj.name }}":
{%- if cfg.use_spatial_identification %}
{{note("Spatial identification allows to use different resources for each instance", indent)}}
{{note("Draw single instance with custom mesh (called in per-instance loop)", indent)}}
{{ draw_spacing }}drawindexed = {{ obj.index_count }}, {{ obj.index_offset }}, 0
{%- else %}
{{note("Draw all instances with custom mesh at once", indent)}}
{{ draw_spacing }}drawindexedinstanced = {{ obj.index_count }}, INSTANCE_COUNT, {{ obj.index_offset }}, 0, FIRST_INSTANCE
{%- endif %}
{%- if cfg.use_ini_toggles %}
endif
{%- endif %}
{%- endfor %}

{%- endif %}

{%- endfor %}


; ------------------------------------------------------------------------------
; - DRAW CALLS PROCESSOR
; ------------------------------------------------------------------------------

[Pool_ObjectSpatialIdentity]
pool_size = $max_instance_count * $\EFMIv1\cfg_spatial_instance_load_ratio
pool_index_type = spatial
pool_spatial_radius = $\EFMIv1\cfg_spatial_base_radius
pool_expiration_timeout_frames = $\EFMIv1\cfg_spatial_expiration_frames
pool_expiration_reset_elements = $\EFMIv1\cfg_spatial_expiration_reset
pool_expiration_refresh_on_read = $\EFMIv1\cfg_spatial_expiration_read_refresh
pool_variable_default_value = $\EFMIv1\cfg_spatial_detault_value


[CommandList_Component_DrawInstances]
{{note("Skip original draw call")}}
handling = skip

{{note("Load object info")}}
$\EFMIv1\component_count = $component_count
{%- if cfg.use_spatial_identification %}
$\EFMIv1\identification_min_components = {{ cfg.spatial_identification_threshold }}
{%- endif %}
{%- if merged_object.skeleton_type.value == "Merged" %}
$\EFMIv1\bones_count = $bones_count
$\EFMIv1\instance_count = $max_instance_count
{%- endif %}
run = CommandList\EFMIv1\Object_ReadConfig

{{note("Load component info")}}
$\EFMIv1\lod_level = $lod_level
{%- if merged_object.skeleton_type.value == "Merged" %}
$\EFMIv1\custom_mesh_scale = {{ '%0.2f'| format(cfg.skeleton_scale) }}
{%- endif %}
run = CommandList\EFMIv1\Component_ReadConfig

{% if cfg.use_spatial_identification -%}
{{note("Spatially identify each component instance to figure out which object it belongs to")}}
Pool\EFMIv1\Input_ObjectSpatialIdentity = ref Pool_ObjectSpatialIdentity
run = CommandList\EFMIv1\SpatialIdentity_IdentifyComponentInstances

{% if merged_object.skeleton_type.value == "Merged" -%}
{{note("Set callback to CommandList which attaches merged skeleton resources to EFMI")}}
CommandList\EFMIv1\Callback_MergedSkeleton_ConnectComponent = ref CommandList_MergedSkeleton_ConnectComponent
{%- endif %}
{{note("Do custom non-instanced draw call for each (spatially identified) instance separately")}}
{{note("Required instance config CB windows manipulation is handled by EFMI automatically")}}
run = CommandList\EFMIv1\Component_DrawInstances
{%- else %}
{{note("Do custom instanced draw call (without decomposition)")}}
run = CommandList\EFMIv1\Component_DrawInstances_NoDecomposition
{%- endif %}

{%- macro draw_override(component_id, component_metadata, hash, index_count, lod_level, is_lod) %}
{{note("Override draw calls for current LoD level of Component %d" | format(component_id))}}
[TextureOverride_EntryPoint_Component{{ component_id }}{% if is_lod %}_LOD{{ lod_level }}{% endif %}]
hash = {{ hash }}
match_index_count = {{ index_count }}
{{ note("Signal our mod that object is found on screen and we can start overriding it") }}
$object_detected = 1
if $mod_enabled && DRAW_TYPE == 4
    $\EFMIv1\component_id = {{ component_id }}
    $\EFMIv1\gpu_posed = {{ (not component_metadata.cpu_posed) | int }}

    {%- if is_lod %}
    {{ note("Signal our mod that object LoD is found on screen and we can start overriding it") }}
    $lod_level = {{ lod_level }}
    {%- else %}
    {{ note("Signal our mod that object LoD is NOT found on screen (only components with LoDs should do it)") }}
    {%- if component_metadata.lods | length > 0 and component_metadata.lods[0].ib_hash != component_metadata.ib_hash %}
    $lod_level = 0
    {%- else %}
    ; No LoD(s) with different IB hash found for this component, so it cannot be used for lod level detection:
    ; $lod_level = 0
    {%- endif %}
    {%- endif %}
    
    {%- if merged_object.skeleton_type.value == "Merged" and merged_object.components[component_id].objects | length == 0 %}
    ; No matching objects found for this component in Blender. Run merged skeleton in read-only mode:
    $\EFMIv1\skip_skeleton_override = 1
    {%- endif %}
    {{ note("Do custom draw calls") }}
    CommandList\EFMIv1\Callback_Component_DrawCustom = ref CommandList_Draw_Component{{ component_id }}
    run = CommandList_Component_DrawInstances
endif

{%- endmacro %}


; ------------------------------------------------------------------------------
; - DRAW CALLS OVERRIDES: LOD_0 (FULL DETAIL)
; ------------------------------------------------------------------------------

{%- for component_id, component_metadata in enumerate(extracted_object.components) %}
{{ draw_override(component_id, component_metadata, component_metadata.ib_hash, component_metadata.index_count, 0, false) }}
{%- endfor %}


{%- set max_lods = extracted_object.components | map(attribute='lods') | map('length') | max %}
{%- for lod_level in range(1, max_lods + 1) %}


; ------------------------------------------------------------------------------
; - DRAW CALLS OVERRIDES: LOD_{{ lod_level }}
; ------------------------------------------------------------------------------

{%- for component_id, component_metadata in enumerate(extracted_object.components) %}
{%- if lod_level - 1 < component_metadata.lods | length %}
{%- set lod = component_metadata.lods[lod_level - 1] %}

{%- if lod.ib_hash != component_metadata.ib_hash %}
{{ draw_override(component_id, component_metadata, lod.ib_hash, lod.index_count, lod_level, true) }}
{%- endif %}

{%- endif %}
{%- endfor %}
{%- endfor %}


; ------------------------------------------------------------------------------
; - TEXTURES
; ------------------------------------------------------------------------------

{%- for texture in textures %}

[Resource_Texture{{ loop.index0 }}]
filename = Textures/{{ texture.filename }}

[TextureOverride_Texture{{ loop.index0 }}]
hash = {{ texture.hash }}
match_priority = 0
if $object_detected
    this = Resource_Texture{{ loop.index0 }}
endif
{%- endfor %}


{%- if merged_object.skeleton_type.value == "Merged" %}


; ------------------------------------------------------------------------------
; - MERGED SKELETON
; ------------------------------------------------------------------------------

[Pool_MergedSkeleton_Component_VertexGroupOffsets]
pool_size = $component_count

[Pool_MergedSkeleton_Component_VertexGroupCounts]
pool_size = $component_count

[Pool_MergedSkeleton_Component_LodRemaps]
pool_size = $component_count * $\EFMIv1\cfg_ms_max_lod_level_count

[Pool_MergedSkeleton_Instance_UpdateFrame]
pool_size = $component_count * $max_instance_count

[Pool_MergedSkeleton_Instance_LodLevel]
pool_size = $component_count * $max_instance_count

[ResourceMergedSkeletonDataRW]
type = RWStructuredBuffer
stride = 16
array = ($\EFMIv1\cfg_ms_implicit_bones_count + $\EFMIv1\cfg_ms_skeletons_count * $bones_count * $max_instance_count) * $\EFMIv1\cfg_ms_bone_entry_size


[Constants]
global $merged_skeleton_initialized = 0


[CommandList_MergedSkeleton_ConnectComponent]
if !$merged_skeleton_initialized
    $merged_skeleton_initialized = 1
    run = CommandListInitializeMergedSkeleton
endif

Pool\EFMIv1\Input_MergedSkeleton_Component_VertexGroupOffsets = ref Pool_MergedSkeleton_Component_VertexGroupOffsets
Pool\EFMIv1\Input_MergedSkeleton_Component_VertexGroupCounts = ref Pool_MergedSkeleton_Component_VertexGroupCounts
Pool\EFMIv1\Input_MergedSkeleton_Component_LodRemaps = ref Pool_MergedSkeleton_Component_LodRemaps

Pool\EFMIv1\Input_MergedSkeleton_Instance_UpdateFrame = ref Pool_MergedSkeleton_Instance_UpdateFrame
Pool\EFMIv1\Input_MergedSkeleton_Instance_LodLevel = ref Pool_MergedSkeleton_Instance_LodLevel

Resource\EFMIv1\Output_MergedSkeleton = ref ResourceMergedSkeletonDataRW

run = CommandList\EFMIv1\MergedSkeleton_AttachComponent

; Force 16-bit VG IDs (since Merged Skeleton usually has more than 256 bones)
vb2->ElementFormat(BLENDINDICES, 0) = R16G16B16A16_UINT


[CommandListInitializeMergedSkeleton]
Resource\EFMIv1\OutputMergedSkeleton_Template = ref ResourceMergedSkeletonDataRW
run = CommandList\EFMIv1\InitializeMergedSkeleton

local $lod_level_count = $\EFMIv1\cfg_ms_max_lod_level_count
local $cmp_id
{%- for component_id, component_metadata in enumerate(extracted_object.components) %}
{%- if not component_metadata.cpu_posed %}
$cmp_id = {{ component_id }}
$Pool_MergedSkeleton_Component_VertexGroupOffsets[$cmp_id] = {{ component_metadata.vg_offset }}
$Pool_MergedSkeleton_Component_VertexGroupCounts[$cmp_id] = {{ component_metadata.vg_count }}
Pool_MergedSkeleton_Component_LodRemaps[$cmp_id * $lod_level_count + 0] = null
{%- for lod_id, lod in enumerate(component_metadata.lods) %}
{%- if "VB2" in lod.vb_formats or lod.vg_map %}
{{note("Use VB2 with LoD mesh layout and/or remapped weights (if LoD mesh uses simplified skeleton)")}}
Pool_MergedSkeleton_Component_LodRemaps[$cmp_id * $lod_level_count + {{ lod_id + 1 }}] = ref Resource_Component{{ component_id }}_VB2_LOD{{ lod_id + 1 }}_BlendRemap
{%- else %}
Pool_MergedSkeleton_Component_LodRemaps[$cmp_id * $lod_level_count + {{ lod_id + 1 }}] = null
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}


{%- if merged_object.shapekeys.max_batches_count > 0 %}


; ------------------------------------------------------------------------------
; - SHAPE KEYS
; ------------------------------------------------------------------------------

; Usage Example (set `Component 0` `Shape Key 0` value to `0.5`):
;
; $component_id = 0
; $shapekey_id = 0
; $shapekey_value = 0.5
; run = CommandListSetShapeKey
;
[CommandListSetShapeKey]
; Check the last set value for this $component_id and $shapekey_id...
local $value_uid = $component_id * $shapekeyed_comp_max_batches * $\EFMIv1\cfg_sk_batch_size + $shapekey_id
if $shapekey_value != $Pool_ShapeKeys_LastSetValues[$value_uid]
	; ... and submit new value to GPU only if it is different.
	; Calling `ShapeKeySetter` just writes new value to buffer, geometry update is deferred.
	$Pool_ShapeKeys_LastSetValues[$value_uid] = $shapekey_value
	$\EFMIv1\shapekey_id = $shapekey_id
	$\EFMIv1\shapekey_value = $shapekey_value
    {{note("Contains shapekey values configured via this CommandList calls.")}}
	Resource\EFMIv1\Output_ShapeKeyValues = ref Pool_ShapeKeyValuesRW[$component_id]
    {{note("Assign specified $shapekey_value to $shapekey_id shapekey in GPU values buffer.")}}
	run = CustomShader\EFMIv1\ShapeKeySetter
	; Signal `CommandList_ShapeKeys_Apply` geometry updater that new value was submitted in this frame.
	$Pool_ShapeKeys_Component_UpdateId[$component_id] = FRAME_NUMBER
endif


[Constants]
global $position_instance_count = {{ merged_object.shapekeys.max_lod_position_count + 1 }}
global $shapekeyed_comp_max_batches = {{ merged_object.shapekeys.max_batches_count }}
global $shapekeyed_comp_max_vertices = {{ merged_object.shapekeys.max_vertex_count }}
global $shapekeyed_components_count = {{ merged_object.shapekeys.shapekeyed_components_count }}
global $shapekeyed_positions_count = {{ merged_object.shapekeys.shapekeyed_components_count * (merged_object.shapekeys.max_lod_position_count + 1) }}

global $component_id = 0
global $shapekey_id = 0
global $shapekey_value = 0

global $shapekeys_batch_uid = 0
global $shapekeyed_position_uid = 0

run = CommandListInitializeShapeKeys


[CommandListInitializeShapeKeys]
{%- for component_data in merged_object.components %}
{%- if component_data.shapekeys.vertex_count > 0 %}

$component_id = {{ component_data.id }}

$Pool_ShapeKeys_LodPositionCount[$component_id] = {{ component_data.shapekeys.lod_position_count }}
$Pool_ShapeKeys_BatchCount[$component_id] = {{ component_data.shapekeys.batches | length }}
Pool_ShapeKeyBatchConfigs[$component_id] = ref Resource_Component{{ component_data.id }}_ShapeKeyBatchConfigs
Pool_ShapeKeyVertexIds[$component_id] = ref Resource_Component{{ component_data.id }}_ShapeKeyVertexIds
Pool_ShapeKeyVertexOffsets[$component_id] = ref Resource_Component{{ component_data.id }}_ShapeKeyVertexOffsets

$shapekeyed_position_uid = $component_id * $\EFMIv1\cfg_sk_max_lod_level_count
Pool_VertexPositions[$shapekeyed_position_uid] = copy Resource_Component{{ component_data.id }}_VB0
Pool_ShapeKeyedPositionsRW[$shapekeyed_position_uid] = copy Resource_Component{{ component_data.id }}_VB0

{%- if component_data.shapekeys.lod_position_count > 0 %}

{%- for lod_id, lod in enumerate(extracted_object.components[component_data.id].lods) %}
$shapekeyed_position_uid = $shapekeyed_position_uid + 1
Pool_VertexPositions[$shapekeyed_position_uid] = copy Resource_Component{{ component_data.id }}_VB0_LOD{{ lod_id + 1 }}
Pool_ShapeKeyedPositionsRW[$shapekeyed_position_uid] = copy Resource_Component{{ component_data.id }}_VB0_LOD{{ lod_id + 1 }}

{%- endfor %}

{%- endif %}

{%- for batch_id, batch in enumerate(component_data.shapekeys.batches) %}

$shapekeys_batch_uid = $component_id * $\EFMIv1\cfg_sk_max_batch_count + {{ batch_id }}
$Pool_ShapeKeys_BatchVertexCount[$shapekeys_batch_uid] = {{ batch.vertex_count }}
{%- endfor %}

{%- endif %}
{%- endfor %}


[CommandList_ShapeKeys_AttachComponent]
Pool\EFMIv1\Input_ShapeKeys_BatchCount = ref Pool_ShapeKeys_BatchCount
Pool\EFMIv1\Input_ShapeKeys_BatchVertexCount = ref Pool_ShapeKeys_BatchVertexCount
{{note("Contains position deltas quantisation scales and per-batch configs.")}}
Pool\EFMIv1\Input_ShapeKeys_BatchConfigs = ref Pool_ShapeKeyBatchConfigs
{{note("Contains IDs of vertices affected by shapekeys.")}}
Pool\EFMIv1\Input_ShapeKeys_VertexIds = ref Pool_ShapeKeyVertexIds
{{note("Contains per-vertex XYZ position deltas calculated for max shapekey value (1.0).")}}
